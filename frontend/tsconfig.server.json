{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Node code: the Express server, the stats module, and the one-off data
     prep script. Deliberately no DOM lib — server code that reaches for
     `window` or `document` should fail to compile here. */
  "include": ["src/server", "src/lib/types.ts", "scripts"]
}
